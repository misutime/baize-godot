<!-- editor-ui.csproj —— 编辑器 UI 应用（src/apps；引擎核心可交付）
     职责：Avalonia UI（Hierarchy/Inspector）+ 复用 src/libs/editor 的 EditorSession。
     门禁：本宿主可引 Avalonia；src/libs/editor 保持零 Godot 零 UI 依赖。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Sola3d.EditorUi</RootNamespace>
    <AssemblyName>editor-ui</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\libs\editor\Sola3d.Editor.csproj" />
    <ProjectReference Include="..\..\libs\gameobject\Sola3d.GameObject.csproj" />
    <PackageReference Include="Avalonia" Version="11.2.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.7" />
  </ItemGroup>
</Project>