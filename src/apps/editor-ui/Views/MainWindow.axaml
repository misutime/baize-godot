<!-- MainWindow.axaml —— 编辑器主窗口：工具栏（新建/删除/保存/加载）+ Hierarchy | 3D view | Inspector
     面板可拖拽调宽（1px GridSplitter）；Hierarchy/Inspector 为独立 UserControl（M2 可直接搬入 dock）。 -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sola3d.EditorUi.ViewModels"
        xmlns:views="using:Sola3d.EditorUi.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="Sola3d.EditorUi.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding DocumentTitle}"
        Width="1280" Height="720">

  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Padding="8,4" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBlock Text="{Binding DocumentTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="新建" Command="{Binding NewCommand}" />
        <Button Grid.Column="2" Content="删除" Command="{Binding DeleteCommand}" />
        <Button Grid.Column="3" Content="保存" Command="{Binding SaveCommand}" />
        <Button Grid.Column="4" Content="加载" Command="{Binding LoadCommand}" />
      </Grid>
    </Border>

    <!-- 三面板：Hierarchy | 3D view 占位 | Inspector（GridSplitter 1px 拖拽条） -->
    <Grid ColumnDefinitions="250,1,*,1,300">
      <Border Grid.Column="0" MinWidth="140" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <views:HierarchyView />
      </Border>
      <GridSplitter Grid.Column="1" Width="1" ResizeDirection="Columns" Background="Transparent" />
      <Border Grid.Column="2">
        <TextBlock Margin="12" Text="3D View（下一步：接入 GodotDesignPreview/预演投影）" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
      <GridSplitter Grid.Column="3" Width="1" ResizeDirection="Columns" Background="Transparent" />
      <Border Grid.Column="4" MinWidth="180" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
        <views:InspectorView />
      </Border>
    </Grid>
  </DockPanel>
</Window>