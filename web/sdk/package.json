{
  "name": "@baize/ui-sdk",
  "version": "0.1.0",
  "description": "WebDock 桥协议 SDK：CefViewClient 传输层 + 类型化方法/事件注册表 + React hooks（协议见 doc/plans/WebUI架构-桥协议与前端SDK.md §3）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
