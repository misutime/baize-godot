{
  "name": "@baize/app",
  "version": "0.1.0",
  "description": "baize-godot 编辑器 Electron 应用（渲染进程 React UI + 主进程 godot-process）",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pretest": "vite build --mode=test",
    "test:e2e": "pnpm pretest && playwright test"
  },
  "dependencies": {
    "@baize/godot-process": "workspace:*",
    "@baize/godot-rpc": "workspace:*",
    "@baize/godot-sdk": "workspace:*",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.0.1"
  }
}
