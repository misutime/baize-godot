{
  "name": "@baize/godot-sdk",
  "version": "0.1.0",
  "description": "能力面客户端：方法绑定 + 事件订阅 + react hooks（transport 由调用方注入，零传输依赖）",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@baize/godot-rpc": "workspace:*"
  }
}