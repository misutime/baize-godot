<Solution>
  <!-- Sola3d C# 应用统一入口（2026-08-23 建立；2026-08-24 统一到 src/）：
       All-in C# 的库 + 测试 + 宿主应用全收 src/ 下（libs / tests / apps）。
       Godot 上游绑定（GodotTools/GodotSharp/Godot.NET.Sdk）不在此——属引擎侧，各自独立 sln。 -->
  <Folder Name="/libs/">
    <Project Path="src/libs/gameobject/Sola3d.GameObject.csproj" />
    <Project Path="src/libs/mainloop/Sola3d.MainLoop.csproj" />
    <Project Path="src/libs/editor/Sola3d.Editor.csproj" />
    <Project Path="src/libs/ecs/Sola3d.Ecs.csproj" />
    <Project Path="src/libs/ecs-generator/Sola3d.Ecs.Generator.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="src/tests/gameobject-core-tests/gameobject-core-tests.csproj" />
    <Project Path="src/tests/mainloop-core-tests/mainloop-core-tests.csproj" />
    <Project Path="src/tests/vertical-slice-tests/vertical-slice-tests.csproj" />
    <Project Path="src/tests/editor-core-tests/editor-core-tests.csproj" />
    <Project Path="src/tests/shooter-object-components/Shooter.Objects.csproj" />
    <Project Path="src/tests/shooter-object-components-poc/shooter-object-components-poc.csproj" />
  </Folder>
  <Folder Name="/apps/">
    <Project Path="src/apps/godot-slice/godot-slice.csproj" />
    <Project Path="src/apps/editor-ui/editor-ui.csproj" />
  </Folder>
</Solution>